# Apache/LiteSpeed configuration, deployed with the site.
#
# Hostinger runs LiteSpeed, which reads .htaccess — one of the reasons the site
# stayed on this host rather than moving. It is served from the repo so the
# redirect map is version-controlled alongside the pages it points at.
#
# NOTE the deploy must be configured to include dotfiles, or this is silently
# left behind and every rule here quietly stops applying.

# ---------------------------------------------------------------- canonical
# One address for the site. Without this, the same page is reachable at four
# URLs (http/https x www/apex), which splits its search ranking and makes a
# shared link look different depending on who copied it.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://baptisthss.in/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.baptisthss\.in$ [NC]
  RewriteRule ^(.*)$ https://baptisthss.in/$1 [R=301,L]
</IfModule>

# ---------------------------------------------------------------- old WordPress URLs
# ADDED AT MIGRATION, NOT BEFORE. Every post that existed on the WordPress site
# needs a line here pointing at its new address, or a link someone shared years
# ago starts returning 404 and its search ranking is lost. The migration script
# generates these from the export; they are pasted in below.
#
#
# The 35 published posts, generated by migration/migrate.py. Each MUST keep
# pointing at its new address: these are links parents have shared and that
# Google has indexed, and a 404 loses both the visitor and the ranking.
Redirect 301 /2024/08/01/2nd-term-start-date-test-post/ https://baptisthss.in/news/2nd-term-start-date-test-post/
Redirect 301 /2024/08/05/school-academic-calendar-2024-2025/ https://baptisthss.in/news/school-academic-calendar-2024-2025/
