# ---------------------------------------------------------------- moved pages
# /about/ became /school/ when About turned into a menu holding School and
# Faculty. The page was only ever public inside /preview/, so this is insurance
# rather than a repair — cheap, and the alternative is a 404 for anyone who was
# sent the preview link.
Redirect 301 /about/ https://baptisthss.in/school/

# The preview folder is deleted at cutover, so every link shared while the new
# site was being built would 404. Redirect is a PREFIX match, so this one line
# also carries /preview/news/whatever/ to /news/whatever/.
Redirect 301 /preview/ https://baptisthss.in/

# ------------------------------------------------- the old WordPress PAGES
# The 35 post URLs above are only half the old site. WordPress also published 45
# pages and category listings, EVERY ONE OF WHICH ANSWERS 200 TODAY — taken from
# its own wp-sitemap.xml, so this is what it says it has, not a guess.
#
# Mind /admission/ -> /admissions/: the old page was singular and the new one is
# plural, which is exactly the sort of near-miss that 404s in silence.
Redirect 301 /admission/      https://baptisthss.in/admissions/
Redirect 301 /notice/         https://baptisthss.in/notices/
Redirect 301 /teachers/       https://baptisthss.in/faculty/
Redirect 301 /staff-profile/  https://baptisthss.in/faculty/

# The category listings. Each goes to the section that now holds those posts —
# scholarships, results and examinations are notices; the rest is news.
Redirect 301 /category/administrative/            https://baptisthss.in/notices/
Redirect 301 /category/administrative/notice/     https://baptisthss.in/notices/
Redirect 301 /category/administrative/result/     https://baptisthss.in/notices/
Redirect 301 /category/administrative/examination/ https://baptisthss.in/notices/
Redirect 301 /category/administrative/admission/  https://baptisthss.in/admissions/
Redirect 301 /category/administrative/office/     https://baptisthss.in/contact/
Redirect 301 /category/scholarship/               https://baptisthss.in/notices/
Redirect 301 /category/downloadable/              https://baptisthss.in/downloads/
Redirect 301 /category/news/                      https://baptisthss.in/news/
Redirect 301 /category/general/                   https://baptisthss.in/news/
Redirect 301 /category/gospel-meeting/            https://baptisthss.in/news/
Redirect 301 /category/sports/                    https://baptisthss.in/news/
Redirect 301 /category/cca/                       https://baptisthss.in/news/
Redirect 301 /category/teachers-day/              https://baptisthss.in/news/
Redirect 301 /category/adv-x-mas/                 https://baptisthss.in/news/
Redirect 301 /category/ticker/                    https://baptisthss.in/news/

# The old result system's own pages. That job belongs to the portal now, and the
# portal is on a different host — so these leave the site rather than land on a
# page here that cannot do what the visitor came for.
Redirect 301 /login/            https://portal.baptisthss.in/
Redirect 301 /logout/           https://portal.baptisthss.in/
Redirect 301 /register/         https://portal.baptisthss.in/
Redirect 301 /password-reset/   https://portal.baptisthss.in/
Redirect 301 /account/          https://portal.baptisthss.in/
Redirect 301 /user/             https://portal.baptisthss.in/
Redirect 301 /subscribers/      https://portal.baptisthss.in/
Redirect 301 /exam-marks-entry/ https://portal.baptisthss.in/
Redirect 301 /hss-result-preview/ https://portal.baptisthss.in/
Redirect 301 /posts/            https://baptisthss.in/news/
Redirect 301 /privacy-policy-2/ https://portal.baptisthss.in/privacy.html

# DELIBERATELY NOT REDIRECTED, and listed so nobody wonders whether they were
# forgotten: /3029-2/, /columns-block/, /default-width/, /image-gallery-block/,
# /left-sidebar/, /narrow-width/, /quote-block/, /right-sidebar/, /table-block/
# and /terms-of-service/. The first nine are the WordPress theme's own demo
# pages, published by accident and about nothing; the last never had content the
# school wrote. A 404 is the honest answer where there is no equivalent, and
# sending them to the home page would only teach Google that the home page is
# what they were about.

# Anything under the old dated paths that has no specific replacement falls back
# to the news index rather than a 404 — a reader landing on the right section is
# better than a dead end.
<IfModule mod_rewrite.c>
  RewriteRule ^[0-9]{4}/[0-9]{2}/.*$ /news/ [R=301,L]
</IfModule>

# ---------------------------------------------------------------- errors
ErrorDocument 404 /404.html

# ---------------------------------------------------------------- caching
# The HTML must stay fresh, or a published post would not appear until a
# visitor's cache expired.
#
# CSS IS ONLY SAFE TO HOLD BECAUSE ITS ADDRESS CARRIES A CONTENT HASH — the build
# writes styles.css?v=<hash> into every page. Without that stamp this week-long
# rule serves a returning visitor today's markup dressed in last week's
# stylesheet, and the fault is invisible to anyone testing with an empty cache.
# If the stamp is ever removed, this line has to come down with it.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Directory listings are off: a folder with no index should reveal nothing.
Options -Indexes
