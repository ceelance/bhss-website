# Apache/LiteSpeed configuration, deployed with the site.
#
# Hostinger runs LiteSpeed, which reads .htaccess — one of the reasons the site
# stayed on this host rather than moving. It is served from the repo so the
# redirect map is version-controlled alongside the pages it points at.
#
# NOTE the deploy must be configured to include dotfiles, or this is silently
# left behind and every rule here quietly stops applying.

# ---------------------------------------------------------------- canonical
# One address for the site. Without this, the same page is reachable at four
# URLs (http/https x www/apex), which splits its search ranking and makes a
# shared link look different depending on who copied it.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://baptisthss.in/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.baptisthss\.in$ [NC]
  RewriteRule ^(.*)$ https://baptisthss.in/$1 [R=301,L]
</IfModule>

# ---------------------------------------------------------------- old WordPress URLs
# ADDED AT MIGRATION, NOT BEFORE. Every post that existed on the WordPress site
# needs a line here pointing at its new address, or a link someone shared years
# ago starts returning 404 and its search ranking is lost. The migration script
# generates these from the export; they are pasted in below.
#
#   Redirect 301 /2024/05/annual-sports-day/ https://baptisthss.in/news/annual-sports-day/
#
# Anything under the old dated paths that has no specific replacement falls back
# to the news index rather than a 404 — a reader landing on the right section is
# better than a dead end.
<IfModule mod_rewrite.c>
  RewriteRule ^[0-9]{4}/[0-9]{2}/.*$ /news/ [R=301,L]
</IfModule>

# ---------------------------------------------------------------- errors
ErrorDocument 404 /404.html

# ---------------------------------------------------------------- caching
# The HTML must stay fresh, or a published post would not appear until a
# visitor's cache expired. Images and CSS are safe to hold for a week.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Directory listings are off: a folder with no index should reveal nothing.
Options -Indexes
