# ---------------------------------------------------------------- moved pages
# /about/ became /school/ when About turned into a menu holding School and
# Faculty. The page was only ever public inside /preview/, so this is insurance
# rather than a repair — cheap, and the alternative is a 404 for anyone who was
# sent the preview link.
Redirect 301 /about/ https://baptisthss.in/school/

# Anything under the old dated paths that has no specific replacement falls back
# to the news index rather than a 404 — a reader landing on the right section is
# better than a dead end.
<IfModule mod_rewrite.c>
  RewriteRule ^[0-9]{4}/[0-9]{2}/.*$ /news/ [R=301,L]
</IfModule>

# ---------------------------------------------------------------- errors
ErrorDocument 404 /404.html

# ---------------------------------------------------------------- caching
# The HTML must stay fresh, or a published post would not appear until a
# visitor's cache expired. Images and CSS are safe to hold for a week.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Directory listings are off: a folder with no index should reveal nothing.
Options -Indexes
